# 모델 순위 주 1회 측정 (#305).
#
# `model-pick.mjs` 는 목록 조회로 **은퇴**를 잡지만 "목록에는 있는데 느리거나 못 하는"
# 경우는 못 잡는다. 그건 실제로 돌려 봐야 안다.
#
# 한도 소진을 무능으로 치지 않는다 — `skip` 으로 남기고 이전 순위를 지킨다. 그래야
# 무료 일일 한도 한 번에 멀쩡한 모델이 영구 강등되지 않는다(처음 잴 때 실제로 겪었다).
#
# 설치:
#   sudo install -m 0644 ai-team-bakeoff.service /etc/systemd/system/ai-team-bakeoff.service
#   sudo install -m 0644 ai-team-bakeoff.timer   /etc/systemd/system/ai-team-bakeoff.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now ai-team-bakeoff.timer
#
# 한 번 돌려 보기: sudo systemctl start ai-team-bakeoff.service
[Unit]
Description=AI 개발팀 모델 순위 측정 (주 1회)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seungrye
Group=seungrye
WorkingDirectory=/home/seungrye/site
Environment=PATH=/home/seungrye/.local/bin:/home/seungrye/.nvm/versions/node/v20.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/seungrye/site/scripts/ai-team/bakeoff.mjs
# 후보 수 × 모델당 상한(300초) 에 여유. 넘으면 그 주는 건너뛴다.
TimeoutStartSec=3600
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-team-bakeoff
