# ── nginx jail (L7 남용 차단) ────────────────────────────────────────────────
# nginx 의 limit_req(=/etc/nginx/conf.d/ratelimit.conf)와 물려 돈다:
# nginx 가 429 로 한 건씩 튕기고, 반복 위반하는 IP 는 여기서 통째로 차단된다.
#
# 이 파일은 jail.local **다음에** 읽히므로 [DEFAULT] 키를 덮어쓴다
# (읽는 순서: jail.conf → jail.d/*.conf → jail.local → jail.d/*.local).

[DEFAULT]
# 로컬과 집 안 망은 절대 차단하지 않는다. 이게 없으면 리밋을 실측하다가
# 스스로를 잠그고 SSH 까지 막힌다.
ignoreip = 127.0.0.1/8 ::1 192.168.0.0/24

# 레이트리밋을 반복해서 넘는 IP. 정상 사용자는 burst 가 넉넉해 여기 닿지 않는다
# (한 페이지가 자산 수십 개를 불러도 burst 200 안에서 끝난다).
[nginx-limit-req]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/error.log
findtime = 10m
maxretry = 30
bantime  = 1h

# wp-admin·/wp-json 같은 존재하지 않는 경로를 훑는 스캐너.
# access.log(404) 와 error.log(파일 없음) 두 형식을 모두 본다.
[nginx-botsearch]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/access.log
           /var/log/nginx/error.log
findtime = 10m
maxretry = 5
bantime  = 24h

# deny 규칙에 반복해서 부딪히는 IP — minio-console 처럼 내부망 전용으로 잠가 둔
# 곳을 외부에서 계속 두드리는 경우다. 실제로 그런 로그가 쌓이고 있었다.
[nginx-forbidden]
enabled  = true
port     = http,https
logpath  = /var/log/nginx/error.log
findtime = 10m
maxretry = 10
bantime  = 12h
