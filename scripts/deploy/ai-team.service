# AI 개발팀 야간 러너 (#207) — ai-team.timer 가 하루 한 번 부른다.
#
# 자율성 수준은 (A) 제안만이다. run.sh 가 claude 를 **파일 수정 도구 없이** 띄우므로
# 프롬프트가 잘못 읽혀도 코드를 못 고친다. 밖으로 나가는 쓰기는 덧글 하나뿐이다.
#
# 설치:
#   sudo install -m 0644 ai-team.service /etc/systemd/system/ai-team.service
#   sudo install -m 0644 ai-team.timer   /etc/systemd/system/ai-team.timer
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-team.timer
#
# 한 번 돌려 보기(타이머 무시):  sudo systemctl start ai-team.service
# 무슨 일이 있었나:              journalctl -u ai-team.service -n 200

[Unit]
Description=AI 개발팀 야간 러너 (요청 스레드 확인 → 덧글)
# 내가 끝나면 코더가 이어 돈다 (#266). Requires 가 아니라 Wants 인 이유: 내가 실패해도
# 코더는 돌아도 된다 — 마지막 덧글이 사람이면 코더는 어차피 아무것도 안 한다.
Wants=ai-team-coder.service
Before=ai-team-coder.service
# 새벽에 네트워크가 아직 안 올라와 있으면 API 호출이 통째로 실패한다.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seungrye
Group=seungrye
WorkingDirectory=/home/seungrye/site
Environment=PATH=/home/seungrye/.local/bin:/home/seungrye/.nvm/versions/node/v20.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/seungrye/site/scripts/ai-team/run.sh
# 스레드가 여러 개면 오래 걸릴 수 있다. 그래도 무한정 붙들지는 않는다.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-team
