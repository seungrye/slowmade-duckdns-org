server {
	server_name slowmade.duckdns.org;
	client_max_body_size 16M;

	gzip on;
	gzip_comp_level 6;
	gzip_min_length 256;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		text/plain
		text/css
		text/javascript
		application/javascript
		application/json
		application/xml
		application/rss+xml
		application/atom+xml
		image/svg+xml
		application/font-woff2;


	brotli on;
	brotli_types text/plain text/css text/javascript application/javascript application/json application/wasm image/svg+xml font/ttf font/otf font/woff font/woff2;
	brotli_comp_level 6;

	# bevy-rogue WASM/JS/assets 정적 서빙 — 파일 존재 시 nginx 가 직접 (brotli/gzip 협상).
	# 페이지 라우트(/games/bevy-rogue/ 등) 또는 미존재 파일은 Next.js 로 폴백.
	location ~ ^/games/bevy-rogue/(?<asset>.+\.(?:wasm|js|json|png|svg|ron|log|html|css|ttf|otf|woff2?))$ {
		root /home/seungrye/site/webapp/public;
		brotli_static on;
		gzip_static on;
		types {
			application/wasm wasm;
			application/javascript js;
			text/html html;
			image/png png;
			image/svg+xml svg;
			text/plain log;
			application/json json;
			text/css css;
			font/woff2 woff2;
			font/woff woff;
			font/ttf ttf;
			font/otf otf;
		}
		default_type application/octet-stream;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Content-Type-Options "nosniff" always;
		try_files $uri @nextjs;
	}

	# 정적 파일이 없으면 Next.js 로 위임.
	location @nextjs {
		proxy_pass http://webapp;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;
	}

	# MinIO(S3) apex 경로 프록시 — minio-api 서브도메인 DNS 간헐 실패 우회.
	# /s3/<bucket>/<key> → minio_s3 의 /<bucket>/<key> (path-style 이라 Host 무관).
	# ── MinIO 노출 차단 (#165) ─────────────────────────────────────────────
	# `/s3/` 는 버킷 **전체**를 익명으로 프록시한다. 그래서 앱이 인증으로 지키던 것들이
	# 주소만으로 새어 나갔다 — 롬(retro-roms)·세이브(retro-states)·비공개 글 첨부(attachments).
	# 코드의 의도는 분명하다: "공개 /s3/ 경로를 쓰지 않는 이유: 주소만 알면 누구나 받아 갈 수
	# 있기 때문"(api/games/retro/roms/[id]/file). 그 의도를 여기서 강제한다.
	#
	# regex location 은 prefix location(/s3/) 보다 우선하므로 아래가 먼저 걸린다.

	# 버킷 목록 금지 — 키가 랜덤이어도 목록이 열리면 무의미해진다(실제로 1000+ 건 열거됐다).
	location ~ ^/s3/[^/]+/?$ {
		return 404;
	}

	# 앱이 인증으로 내려주는 것들은 공개 경로로 못 가져간다.
	location ~ ^/s3/[^/]+/(retro-roms|retro-states|retro-patches|retro-covers|attachments)/ {
		return 404;
	}

	location /s3/ {
		rewrite ^/s3/(.*)$ /$1 break;
		proxy_pass http://minio_s3;
		proxy_set_header Host $http_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_connect_timeout 300s;
		proxy_send_timeout 300s;
		proxy_read_timeout 300s;
		proxy_buffering off;
		proxy_request_buffering off;
		proxy_redirect off;
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		chunked_transfer_encoding off;
		# 이미지 캐시 — 브라우저/CDN 재요청 감소
		add_header Cache-Control "public, max-age=86400" always;
		add_header X-Content-Type-Options "nosniff" always;
	}

	# owner(관리자) 대용량 첨부 — 앱 로직(isOwner)이 owner 만 100MB 허용, 일반 유저는 15MB 에서 413.
	# exact-match(=) 가 prefix `location /api/` 보다 우선 → 이 경로만 100M, 나머지 API·전체는 server 기본 16M 유지.
	location = /api/attachment/upload {
		client_max_body_size 100M;
		proxy_pass http://webapp;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;

		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
	}

	# 고전 게임 롬 업로드 (#146) — 분할 셋·아케이드 롬셋이 커서 50M 까지 받는다.
	# exact-match(=) 가 prefix `location /api/` 보다 우선 → **이 경로만** 50M,
	# 나머지 API·전체는 server 기본 16M 유지. 앱 상한(MAX_ROM_BYTES)과 같은 값이어야 한다.
	location = /api/games/retro/rom-upload {
		client_max_body_size 50M;
		proxy_pass http://webapp;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;

		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
	}

	location /api/ {
		proxy_pass http://webapp;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;

		# #297 API 는 upstream 의 Cache-Control 그대로 (max-age=60 + SWR=300). 보안 헤더만 추가.
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
	}

	location / {
		proxy_pass http://webapp;  # Next.js dev/prod server
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_set_header Host $host;
		proxy_cache_bypass $http_upgrade;

		# 보안 헤더
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Permissions-Policy "geolocation=(), microphone=()" always;

		# Cache-Control (HTML)
		add_header Cache-Control "no-cache" always;
	}

	listen 443 ssl; # managed by Certbot
	ssl_certificate /etc/letsencrypt/live/slowmade.duckdns.org/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/slowmade.duckdns.org/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
	listen 80;
	listen [::]:80; # Add IPv6 listening if you have it enabled on your server
	server_name slowmade.duckdns.org;
	return 301 https://$host$request_uri;
}

upstream minio_s3 {
   least_conn;
   server 127.0.0.1:9000;
}

upstream minio_console {
   least_conn;
   server 127.0.0.1:9090;
}

server {
	listen 443 ssl;
	http2 on;
	listen [::]:443 ssl;

	server_name minio-api.slowmade.duckdns.org;

	# Allow special characters in headers
	ignore_invalid_headers off;
	# Allow any size file to be uploaded.
	# Set to a value such as 1000m; to restrict file size to a specific value
	client_max_body_size 0;
	# Disable buffering
	proxy_buffering off;
	proxy_request_buffering off;

	# 보안 관련 헤더 (선택 사항)
	add_header X-Content-Type-Options "nosniff";
	add_header X-XSS-Protection "1; mode=block";
	add_header X-Frame-Options "SAMEORIGIN";

	# ── MinIO 직접 노출 차단 (#165) ────────────────────────────────────────
	# 이 도메인은 MinIO 를 그대로 프록시한다. `/s3/` 를 막아도 여기가 열려 있으면 소용없다.
	# (실제로 여기서도 목록 조회와 롬 다운로드가 됐다.)
	location ~ ^/[^/]+/?$ {
		return 404;
	}
	location ~ ^/[^/]+/(retro-roms|retro-states|retro-patches|retro-covers|attachments)/ {
		return 404;
	}

	location / {
		# minio-api.slowmade.duckdns.org 접속 시 호스트의 9000번 포트로 프록시
		proxy_pass http://minio_s3;
		proxy_set_header Host $http_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		#proxy_set_header X-Nginx-Proxy true;
		proxy_connect_timeout 300s;
		proxy_send_timeout 300s;
		proxy_read_timeout 300s;
		proxy_buffering off;
		proxy_redirect off;

		# Default is HTTP/1, keepalive is only enabled in HTTP/1.1
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		chunked_transfer_encoding off;

    		add_header Cache-Control "no-cache" always;
	}

	#location / {
	#	proxy_pass http://localhost:9000;  # api server
	#	proxy_http_version 1.1;
	#	proxy_set_header Upgrade $http_upgrade;
	#	proxy_set_header Connection 'upgrade';
	#	proxy_set_header Host $host;
	#	proxy_cache_bypass $http_upgrade;
	#}

	#listen [::]:443 ssl ipv6only=on; # managed by Certbot
	#listen 443 ssl; # managed by Certbot
	ssl_certificate /etc/letsencrypt/live/minio-api.slowmade.duckdns.org/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/minio-api.slowmade.duckdns.org/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
	listen 80;
	listen [::]:80;
	server_name minio-api.slowmade.duckdns.org;
	return 301 https://$host$request_uri;
}

server {
	listen 443 ssl;
	http2 on;
	listen [::]:443 ssl;

	server_name minio-console.slowmade.duckdns.org;

	# Allow special characters in headers
	ignore_invalid_headers off;
	# Allow any size file to be uploaded.
	# Set to a value such as 1000m; to restrict file size to a specific value
	client_max_body_size 0;
	# Disable buffering
	proxy_buffering off;
	proxy_request_buffering off;

	# 보안 관련 헤더 (선택 사항)
	add_header X-Content-Type-Options "nosniff";
	add_header X-XSS-Protection "1; mode=block";
	add_header X-Frame-Options "SAMEORIGIN";

	location / {
		# minio-console.slowmade.duckdns.org 접속 시 호스트의 9090번 포트로 프록시
		# 내부망(192.168.0.0/24)·로컬만 — 콘솔 인터넷 노출 차단(보안 감사 HIGH)
		allow 192.168.0.0/24;
		allow 127.0.0.1;
		deny all;
		proxy_pass http://minio_console;
		proxy_set_header Host $http_host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Nginx-Proxy true;
		proxy_connect_timeout 300s;
		proxy_send_timeout 300s;
		proxy_read_timeout 300s;
		proxy_buffering off;
		proxy_redirect off;

		# This is necessary to pass the correct IP to be hashed
		real_ip_header X-Real-IP;

		# To support websocket
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";

		chunked_transfer_encoding off;

    		add_header Cache-Control "no-cache" always;
	}

	#location / {
	#	proxy_pass http://localhost:9090;  # api console
	#	proxy_http_version 1.1;
	#	proxy_set_header Upgrade $http_upgrade;
	#	proxy_set_header Connection 'upgrade';
	#	proxy_set_header Host $host;
	#	proxy_cache_bypass $http_upgrade;
	#}

	#listen [::]:443 ssl; # managed by Certbot
	#listen 443 ssl; # managed by Certbot
	ssl_certificate /etc/letsencrypt/live/minio-console.slowmade.duckdns.org/fullchain.pem; # managed by Certbot
	ssl_certificate_key /etc/letsencrypt/live/minio-console.slowmade.duckdns.org/privkey.pem; # managed by Certbot
	include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
	ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
	listen 80;
	listen [::]:80;
	server_name minio-console.slowmade.duckdns.org;
	return 301 https://$host$request_uri;
}

