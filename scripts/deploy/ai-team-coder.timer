# 코더 야간 러너 타이머 (#266).
#
# 00:35(KST) 인 이유: 클로드 러너(00:05)가 끝난 뒤다. 30분이면 스레드 몇 개를 도는 데
# 넉넉하고, 클로드가 아직 돌고 있는 중에 코더가 옛 덧글을 보고 답하는 일이 없다.

[Unit]
Description=AI 개발팀 코더 러너 타이머

[Timer]
OnCalendar=*-*-* 00:35:00
# 꺼져 있던 동안 놓친 실행을 부팅 직후에 몰아 돌리지 않는다 —
# 낮에 갑자기 덧글이 달리는 것보다 하루 거르는 편이 낫다.
Persistent=false

[Install]
WantedBy=timers.target
