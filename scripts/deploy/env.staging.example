# webapp/.env.staging — 검수 인스턴스가 실서비스와 달라야 하는 것만 적는다.
#
# `webapp-staging@.service` 가 `.env.local` **뒤에** 이 파일을 읽는다. 그래서 여기 적은 값만
# 덮이고 나머지(도메인·키 등)는 실서비스 설정을 그대로 쓴다.
#
# 원칙: **DB 를 갈랐다고 안전한 게 아니다.** 바깥으로 나가는 것을 하나씩 꺼야 한다.

# ── 반드시 ─────────────────────────────────────────────────────────────
# 없으면 검수 인스턴스도 60초 틱으로 매매를 돌린다. DB 를 갈라도 브로커 API 는 바깥이라
# **실제 주문이 중복으로 나간다.**
TRADING_SCHEDULER_ENABLED=false

# 검수용 DB. scripts/deploy/staging-db-refresh.sh 가 만든다.
MONGO_URI=mongodb://127.0.0.1:27017/handmade-site-staging

# ── 바깥으로 새는 것 막기 ──────────────────────────────────────────────
# 메일은 실제로 발송된다.
EMAIL_ENABLED=false

# 오브젝트 스토리지를 공유하면 검수 중 업로드·삭제가 **실파일**에 반영된다.
# 별도 버킷을 만들어 두고 여기서 가리킨다(없으면 업로드 기능은 검수 불가).
# MINIO_BUCKET=handmade-staging

# 시그널링 서버는 하나뿐이라 방이 섞인다. 검수에선 꺼 둔다.
RETRO_NETPLAY=0

# 앱 제출·인제스트처럼 외부에서 들어오는 경로도 잠가 둔다.
APP_KEY=
STOCK_INGEST_KEY=
