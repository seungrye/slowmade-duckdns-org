# 모델 순위 측정 타이머 (#305) — 주 1회.
#
# 측정 자체가 무료 한도를 쓴다(후보 수 × 과제 1개). 그래서 야간 러너가 도는 시각을 피해
# 일요일 새벽에 둔다. 놓쳐도 다음 주에 다시 돈다 — 순위 파일이 낡으면 러너가 알아서
# 코드의 기본 순서로 떨어지므로 멈추지 않는다.
[Unit]
Description=AI 개발팀 모델 순위 측정 타이머 (주 1회)

[Timer]
OnCalendar=Sun *-*-* 04:30:00
Persistent=false
Unit=ai-team-bakeoff.service

[Install]
WantedBy=timers.target
