# 코더 야간 러너 (#266) — ai-team-coder.timer 가 하루 한 번 부른다.
#
# 클로드 러너(ai-team.service, 00:05) 30분 뒤에 돈다. 클로드가 남긴 덧글에 코더가 답하면서
# 스레드 안에서 둘이 주고받는다. 사람은 아침에 그 오간 것을 본다.
#
# 자율성은 클로드 러너와 같다 — **의견만** 낸다. coder-run.sh 가 opencode 에 편집 도구를
# 주지 않으므로 프롬프트가 잘못 읽혀도 코드를 못 고친다. 실제 편집·PR 은 coder.mjs 가
# 사람이 부를 때 따로 한다.
#
# 설치:
#   sudo install -m 0644 ai-team-coder.service /etc/systemd/system/ai-team-coder.service
#   sudo install -m 0644 ai-team-coder.timer   /etc/systemd/system/ai-team-coder.timer
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-team-coder.timer
#
# 한 번 돌려 보기(타이머 무시):  sudo systemctl start ai-team-coder.service
# 무슨 일이 있었나:              journalctl -u ai-team-coder.service -n 200

[Unit]
Description=AI 개발팀 코더 러너 (클로드 덧글에 응답)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seungrye
Group=seungrye
WorkingDirectory=/home/seungrye/site
Environment=PATH=/home/seungrye/.local/bin:/home/seungrye/.nvm/versions/node/v20.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/seungrye/site/scripts/ai-team/coder-run.sh
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-team-coder
