# 코더 야간 러너 (#266) — ai-team-coder.timer 가 하루 한 번 부른다.
#
# **클로드 러너가 끝나면 이어서 돈다.** 타이머가 따로 없다 — ai-team.service 가 이 유닛을
# 끌어오고(Wants), After 로 순서를 잡는다.
#
# 시각으로 간격을 두지 않는 이유: 클로드 실행 시간이 들쭉날쭉하다(실측 6~20분). 간격을
# 정해 두면 스레드가 늘었을 때 클로드가 아직 도는 중에 코더가 시작해 옛 덧글을 보고 답한다.
# systemd 에 맡기면 그 추측이 사라진다.
#
# 자율성은 클로드 러너와 같다 — **의견만** 낸다. coder-run.sh 가 `--agent commenter` 로
# 띄우고 opencode.json 이 그 에이전트에게서 편집 도구를 빼므로, 프롬프트가 잘못 읽혀도
# 코드를 못 고친다. 실제 편집·PR 은 coder.mjs 가 사람이 부를 때 따로 한다.
#
# 이 문단은 오래 "편집 도구를 주지 않으므로" 라고만 적혀 있었는데 **그때는 사실이 아니었다** —
# opencode 에 아무 제한도 안 걸려 있었고 --dir 가 라이브 작업트리였다. 실측으로 확인하고
# 고쳤다(#286).
#
# 설치:
#   sudo install -m 0644 ai-team-coder.service /etc/systemd/system/ai-team-coder.service
#   sudo systemctl daemon-reload
#
# 계정·클론·env 준비(한 번만):
#   sudo useradd -r -m -d /home/ai-coder -s /bin/bash ai-coder
#   sudo passwd -l ai-coder        # 암호 로그인 잠금. sudo 는 애초에 없다.
#   sudo chmod 750 /home/ai-coder
#
#   **셸은 nologin 이면 안 된다.** opencode 의 bash 도구가 계정의 로그인 셸을 쓰기 때문에
#   nologin 이면 모든 명령이 "This account is currently not available." 로 죽는다(실측).
#   대신 passwd -l 로 잠그고 sudo 를 안 주면 대화형 로그인 경로는 닫힌다.
#   sudo -u ai-coder git clone --depth 1 https://github.com/seungrye/slowmade-duckdns-org.git /home/ai-coder/site
#   # AI_TEAM_KEY·OPENROUTER_API_KEY 두 줄만 담은 파일을 0600 ai-coder 소유로:
#   sudo install -o ai-coder -g ai-coder -m 0600 <두줄파일> /home/ai-coder/ai-team.env
#   # opencode(독립 바이너리)를 전역에:
#   sudo install -m 0755 <opencode-ai/bin/opencode.exe> /usr/local/bin/opencode
#
#   마지막으로 **한 번 손으로 돌려 모델 카탈로그를 데운다.** 새 계정의 첫 실행은
#   ~/.cache/opencode/models.json 이 아직 없어 `Model not found` 로 죽는다(실측). 두 번째
#   실행부터 정상이다.
#   (타이머 없음 — ai-team.service 가 끝나면 systemd 가 이어서 돌린다)
#
# 한 번 돌려 보기(타이머 무시):  sudo systemctl start ai-team-coder.service
# 무슨 일이 있었나:              journalctl -u ai-team-coder.service -n 200

[Unit]
Description=AI 개발팀 코더 러너 (클로드 덧글에 응답)
After=network-online.target
Wants=network-online.target
# 클로드가 **끝난 뒤에** 돈다. Type=oneshot 이라 ExecStart 가 빠져나가야 다음이 시작된다.
After=ai-team.service

[Service]
Type=oneshot
# **전용 계정으로 돈다** (#294). 예전엔 User=seungrye 라 그 계정이 가진 것을 전부
# 물려받았다 — NOPASSWD sudo, gh 토큰(admin:org/repo/workflow), 그리고 --dir 안에 있는
# webapp/.env.local 49개 키(MONGO_URI·NEXTAUTH_SECRET·OAuth secret·MINIO 키…).
# 코더가 실제로 필요한 것은 AI_TEAM_KEY 와 OPENROUTER_API_KEY 둘뿐이다.
#
# ai-coder 는 sudo 가 없고, /home/seungrye(710)에 진입하지 못하며, 자기 클론에는
# .env.local 이 아예 없다(gitignore). 넷 다 실측으로 확인했다.
User=ai-coder
Group=ai-coder
WorkingDirectory=/home/ai-coder/site
# opencode 는 libc 만 쓰는 독립 바이너리라 node 가 필요 없다(실측). /usr/local/bin 에 둔다.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SITE_DIR=/home/ai-coder/site
Environment=ENV_FILE=/home/ai-coder/ai-team.env
# 전용 계정의 클론이라 사람이 갱신해 주지 않는다. 매 실행마다 origin/main 에 맞춘다 —
# 얕은 클론이므로 pull 대신 fetch+reset 으로 로컬 어긋남까지 지운다.
ExecStartPre=/usr/bin/git -C /home/ai-coder/site fetch -q --depth 1 origin main
ExecStartPre=/usr/bin/git -C /home/ai-coder/site reset -q --hard FETCH_HEAD
ExecStart=/home/ai-coder/site/scripts/ai-team/coder-run.sh
# setuid 로 권한을 되찾지 못하게 한다.
NoNewPrivileges=true
# 3시간. 파이프라인(#269)의 논의 루프가 최대 12회 도는데 회차마다 코더 실행과 테스트가
# 붙는다. 예전 30분으로는 못 버틴다. 그래도 무한정 붙들지는 않는다.
TimeoutStartSec=10800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-team-coder
