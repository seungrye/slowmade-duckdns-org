# AI 개발팀 야간 러너 타이머 (#207).
#
# 00:05(KST) 인 이유: 날이 바뀐 직후다. 하루 일이 끝난 뒤 돌고 아침에 결과를 본다.
# 이 호스트는 타임존이 Asia/Seoul 이라 OnCalendar 이 곧 한국시간이다.
#
# 정각(00:00)을 피한 건 이 호스트의 dpkg-db-backup·exim4-base 가 거기 몰려 있어서다.
# logrotate(00:20)와도 겹치지 않는다.

[Unit]
Description=AI 개발팀 야간 러너 타이머

[Timer]
# **10분마다 깨운다. 주기 판정은 러너가 한다** (#299).
#
# `OnCalendar=hourly` 로 한 시간마다 부르면, 유닛이 아직 activating 인 동안의 트리거가
# 기존 start job 에 합쳐져 사라진다. 90분짜리 실행이면 01:00 이 없어지고 02:00 에야 돈다 —
# "끝나면 바로" 가 안 된다.
#
# 그래서 자주 깨우고 `run.sh` 가 "지난 시작 이후 1시간이 지났나" 만 본다. 안 지났으면
# 즉시 exit 0 이라 거의 공짜다. 주기는 `AI_TEAM_INTERVAL_SEC` 로 바꾼다.
OnCalendar=*:0/10:00
# 꺼져 있던 동안 놓친 실행을 부팅 직후에 몰아 돌리지 않는다 —
# 낮에 갑자기 덧글이 달리는 것보다 하루 거르는 편이 낫다.
Persistent=false
Unit=ai-team.service

[Install]
WantedBy=timers.target
