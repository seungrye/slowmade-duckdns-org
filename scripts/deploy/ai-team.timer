# AI 개발팀 야간 러너 타이머 (#207).
#
# 00:05(KST) 인 이유: 날이 바뀐 직후다. 하루 일이 끝난 뒤 돌고 아침에 결과를 본다.
# 이 호스트는 타임존이 Asia/Seoul 이라 OnCalendar 이 곧 한국시간이다.
#
# 정각(00:00)을 피한 건 이 호스트의 dpkg-db-backup·exim4-base 가 거기 몰려 있어서다.
# logrotate(00:20)와도 겹치지 않는다.

[Unit]
Description=AI 개발팀 야간 러너 타이머

[Timer]
OnCalendar=*-*-* 00:05:00
# 꺼져 있던 동안 놓친 실행을 부팅 직후에 몰아 돌리지 않는다 —
# 낮에 갑자기 덧글이 달리는 것보다 하루 거르는 편이 낫다.
Persistent=false
Unit=ai-team.service

[Install]
WantedBy=timers.target
