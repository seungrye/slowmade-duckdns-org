        "arn:aws:s3:::handmade-site/thumbnails/*",
        "arn:aws:s3:::handmade-site/paper-fig-*",
        "arn:aws:s3:::handmade-site/17*",
        "arn:aws:s3:::handmade-site/18*"
      ]
    }
  ]
}
