{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AnonymousReadPublicPrefixesOnly",
      "Effect": "Allow",
      "Principal": { "AWS": ["*"] },
      "Action": ["s3:GetObject"],
      "Resource": [
