{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "commenter": {
      "description": "야간 러너 — 요청 스레드에 덧글만 단다. 코드는 고치지 않는다.",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "*": "deny",
          "*scripts/ai-team/api.sh *": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "git show*": "allow",
          "git -C * log*": "allow",
          "git -C * diff*": "allow",
          "git -C * status*": "allow",
          "git -C * show*": "allow",
          "ls*": "allow",
          "tail*": "allow",
          "head*": "allow",
          "wc*": "allow",
          "grep*": "allow",
          "echo*": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  }
}
