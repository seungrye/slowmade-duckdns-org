{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/check-git-add-commit.sh\"",
            "statusMessage": "git add/commit 분리 실행 확인 중..."
          },
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/check-commit-sequence.sh\"",
            "statusMessage": "커밋 타입 및 순서 검증 중..."
          },
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/check-push-tests.sh\"",
            "statusMessage": "push 전 전체 테스트 실행 중..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/check-src-edit.sh\"",
            "statusMessage": "작업 단계 확인 중..."
          }
        ]
      }
    ]
  }
}
