# ============================================================
# 필수 환경변수 (없으면 서버 시작 불가)
# ============================================================

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                    # openssl rand -base64 32
AUTH_SECRET=                        # NEXTAUTH_SECRET 과 동일값

# MongoDB
MONGO_URI=mongodb://localhost:27017/your-db-name

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESSKEY=
MINIO_SECRETKEY=
MINIO_BUCKET=

# ============================================================
# OAuth 소셜 로그인
# ============================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Firebase (선택 — 없으면 Analytics/Performance 비활성화)
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=   # G-XXXXXXXXXX

# ============================================================
# 포인트 / 업적 (선택 — 기본값 있음)
# ============================================================

# POINTS_FOR_NEW_POST=5
# POINTS_FOR_NEW_COMMENT=1
# DELETE_POST_COST=7
# NEXT_PUBLIC_DELETE_POST_COST=7

# ACHIEVEMENT_FIRST_POST_POINTS=10
