MONGO_URI=mongodb://127.0.0.1:27017/your-db-name

NEXTAUTH_URL=https://your-domain.example.com
NEXTAUTH_SECRET=                    # openssl rand -base64 32
# canonical/OG/sitemap 용 메인 도메인. 미설정 시 NEXTAUTH_URL 로 fallback.
# 로그인 콜백(NEXTAUTH_URL)과 분리해 메인 도메인만 바꿀 때 사용.
SITE_URL=https://your-main-domain.example.com
PRESENCE_API_KEY=                   # openssl rand -hex 32  (Android 앱 인증용)

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# owner 전용 기능(관리자 페이지·자동매매 설정) 게이트 — 이 이메일의 세션만 통과
OWNER_EMAIL=you@example.com

MINIO_ENDPOINT=minio-api.your-domain.example.com
MINIO_PORT=443
MINIO_ACCESSKEY=
MINIO_SECRETKEY=
MINIO_BUCKET=your-bucket-name
# 브라우저 노출용 public URL base. 미설정 시 MINIO_ENDPOINT 로 fallback.
# apex 경로(예: your-domain.example.com/s3)를 쓰면 별도 서브도메인 DNS 없이 이미지 서빙 가능.
MINIO_PUBLIC_HOST=your-domain.example.com/s3

# ============================
# Firebase 콘솔 설정
# ============================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ============================
# 포인트 시스템 설정
# ============================

# 게시물 삭제 비용 (백엔드용)
DELETE_POST_COST=7
# 게시물 삭제 비용 (프론트엔드 확인 메시지용)
NEXT_PUBLIC_DELETE_POST_COST=7

# ============================
# 포인트 획득 설정
# ============================
POINTS_FOR_NEW_POST=5
POINTS_FOR_NEW_COMMENT=1

# ============================
# 업적 달성 포인트
# ============================

# 게시글 관련 업적

# 댓글 관련 업적

# ============================
# 특수 업적 포인트
# ============================

# 첫 추천수 10개 이상 받은 글
GEMINI_API_KEY=
POLLINATIONS_API_KEY=

# ============================
# stock-automator 연동 (ingest API 인증)
# ============================
# 파이썬 데몬이 가격·매매기록·포트폴리오를 push 할 때 x-ingest-key 헤더로 검증
STOCK_INGEST_KEY=                   # openssl rand -hex 32 (파이썬 .env 와 동일 값)

# ============================
# 헤더 달력 배지 (#328)
# ============================
# 공공데이터포털 "한국천문연구원_특일 정보" 서비스 키.
# https://www.data.go.kr 에서 활용신청(무료·자동승인) 후 발급.
#
# **비어 있으면 기능이 조용히 꺼진다** — 배지도 오류도 안 뜬다(default off). 넣으면 켜진다.
# Encoding(인코딩) 키와 Decoding(일반 인증키) 어느 쪽을 넣어도 된다
# (lib/calendar/source.ts 의 encodedKey 가 판별한다).
HOLIDAY_API_KEY=

# ============================
# 자동매매 (dashboard 설정 · lib/trading)
# ============================
# 증권사 자격증명 DB 암호화 키(AES-256-GCM). 분실 시 등록 계정 복호 불가 — 재등록 필요.
TRADING_SECRET_KEY=                 # openssl rand -hex 32
# 서버 전역 실주문 게이트 — 계정별 wire 토글과 AND. false 면 전부 dry-run(주문 로그만).
TRADING_LIVE_ALLOWED=false
# 스케줄러(60초 틱·기동 catch-up) 스위치 — false 면 자동매매 완전 정지(조회도 안 함)
TRADING_SCHEDULER_ENABLED=true
