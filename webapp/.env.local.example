MONGO_URI=mongodb://127.0.0.1:27017/your-db-name

NEXTAUTH_URL=https://your-domain.example.com
NEXTAUTH_SECRET=                    # openssl rand -base64 32
# canonical/OG/sitemap 용 메인 도메인. 미설정 시 NEXTAUTH_URL 로 fallback.
# 로그인 콜백(NEXTAUTH_URL)과 분리해 메인 도메인만 바꿀 때 사용.
SITE_URL=https://your-main-domain.example.com
PRESENCE_API_KEY=                   # openssl rand -hex 32  (Android 앱 인증용)

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# owner 전용 기능(관리자 페이지·자동매매 설정) 게이트 — 이 이메일의 세션만 통과
OWNER_EMAIL=you@example.com

MINIO_ENDPOINT=minio-api.your-domain.example.com
MINIO_PORT=443
MINIO_ACCESSKEY=
MINIO_SECRETKEY=
MINIO_BUCKET=your-bucket-name
# 브라우저 노출용 public URL base. 미설정 시 MINIO_ENDPOINT 로 fallback.
# apex 경로(예: your-domain.example.com/s3)를 쓰면 별도 서브도메인 DNS 없이 이미지 서빙 가능.
MINIO_PUBLIC_HOST=your-domain.example.com/s3

# ============================
# Firebase 콘솔 설정
# ============================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ============================
# 포인트 시스템 설정
# ============================

# 게시물 삭제 비용 (백엔드용)
DELETE_POST_COST=7
# 게시물 삭제 비용 (프론트엔드 확인 메시지용)
NEXT_PUBLIC_DELETE_POST_COST=7

# ============================
# 포인트 획득 설정
# ============================
POINTS_FOR_NEW_POST=5
POINTS_FOR_NEW_COMMENT=1

# ============================
# 업적 달성 포인트
# ============================

# 게시글 관련 업적
ACHIEVEMENT_FIRST_POST_POINTS=10
ACHIEVEMENT_POST_COUNT_10_POINTS=20
ACHIEVEMENT_POST_COUNT_50_POINTS=50
ACHIEVEMENT_POST_COUNT_100_POINTS=100
ACHIEVEMENT_POST_COUNT_250_POINTS=250
ACHIEVEMENT_POST_COUNT_500_POINTS=500
ACHIEVEMENT_POST_COUNT_1000_POINTS=1000
ACHIEVEMENT_POST_COUNT_2500_POINTS=2500
ACHIEVEMENT_POST_COUNT_5000_POINTS=5000
ACHIEVEMENT_POST_COUNT_10000_POINTS=10000

# 댓글 관련 업적
ACHIEVEMENT_FIRST_COMMENT_POINTS=5
ACHIEVEMENT_COMMENT_COUNT_10_POINTS=10
ACHIEVEMENT_COMMENT_COUNT_50_POINTS=25
ACHIEVEMENT_COMMENT_COUNT_100_POINTS=50
ACHIEVEMENT_COMMENT_COUNT_250_POINTS=125
ACHIEVEMENT_COMMENT_COUNT_500_POINTS=250
ACHIEVEMENT_COMMENT_COUNT_1000_POINTS=500

# ============================
# 특수 업적 포인트
# ============================

# 첫 추천수 10개 이상 받은 글
ACHIEVEMENT_POST_10_LIKES_POINTS=50
GEMINI_API_KEY=
POLLINATIONS_API_KEY=

# ============================
# stock-automator 연동 (ingest API 인증)
# ============================
# 파이썬 데몬이 가격·매매기록·포트폴리오를 push 할 때 x-ingest-key 헤더로 검증
STOCK_INGEST_KEY=                   # openssl rand -hex 32 (파이썬 .env 와 동일 값)

# ============================
# AI 개발팀 (/api/ai-team/*)
# ============================
# 야간 러너(Claude·MiniMax)가 요청 스레드를 읽고 덧글을 달 때 x-ai-team-key 헤더로 검증.
# 비어 있으면 세 라우트가 전부 404 로 닫힌다(Default secure).
#
# ⚠ 다른 내부 키들과 달리 **STOCK_INGEST_KEY 폴백이 없다.** 이 키는 주인의 비공개 글에
#   쓰기 권한을 주므로, 파이썬 데몬·안드로이드 앱에 이미 뿌려진 키로 열려서는 안 된다.
#   열리는 범위는 OWNER_EMAIL 의 `ai-req` 태그 비공개 글뿐이다(lib/ai-team/thread-match.ts).
AI_TEAM_KEY=                        # openssl rand -hex 32 (다른 키와 다른 값으로)

# ── AI 코더 (#211) ──────────────────────────────────────────────────────
# ⚠ 아래 키는 위의 AI_TEAM_KEY 와 **정반대 방향**이다. 절대 같은 값을 쓰지 말 것.
#
#     AI_TEAM_KEY        들어오는 요청을 막는 자물쇠 (AI → 우리 사이트)
#     OPENROUTER_API_KEY 밖으로 나갈 때 내미는 신분증 (우리 → OpenRouter)
#
#   섞으면 OpenRouter 키가 곧 주인 비공개 글의 비밀번호가 되는데, 그 키는 모델을 부를
#   때마다 openrouter.ai 로 전송된다.
#
# https://openrouter.ai/keys 에서 발급(sk-or-v1-...). 무료 모델만 쓸 계획이어도 키 하나로
# 유료 모델이 호출되므로 spend limit 을 걸어 둘 것.
OPENROUTER_API_KEY=

# 코더가 쓸 모델. **코드에 박지 않고 여기서 갈아 끼운다** — stealth 모델은 정식 출시되거나
# 내려가면서 예고 없이 사라진다.
#
# 기본값 Ox Alpha (2026-08-23 실측): 무료 · 컨텍스트 1,048,576 · 최대 출력 131,072 ·
# 도구 호출(tools) 지원 · 가동률 99.98%. 소개문이 "long-horizon software engineering" 이다.
#
# ⚠ 프롬프트가 **익명 제공자에게 보관**된다("retained by the provider and are not used for
#   training"). 학습에는 안 쓰지만 보관은 되고, 제공자가 누구인지 공개돼 있지 않다.
#   비공개 글·소스코드를 보내는 경로이므로 알고 쓸 것.
AI_CODER_MODEL=stealth/ox-alpha

# ============================
# 자동매매 (dashboard 설정 · lib/trading)
# ============================
# 증권사 자격증명 DB 암호화 키(AES-256-GCM). 분실 시 등록 계정 복호 불가 — 재등록 필요.
TRADING_SECRET_KEY=                 # openssl rand -hex 32
# 서버 전역 실주문 게이트 — 계정별 wire 토글과 AND. false 면 전부 dry-run(주문 로그만).
TRADING_LIVE_ALLOWED=false
# 스케줄러(60초 틱·기동 catch-up) 스위치 — false 면 자동매매 완전 정지(조회도 안 함)
TRADING_SCHEDULER_ENABLED=true
